# SQLite (default for local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production — change provider in prisma/schema.prisma to "postgresql")
# DATABASE_URL="postgresql://user:password@localhost:5432/nova_panel?schema=public"

AUTH_SECRET="generate-a-long-random-string"
APP_URL="https://your-panel.com"

# Shared secret for POST /api/cron/sync
CRON_SECRET="generate-a-long-random-string"

# Only for pointing the Cloudflare client at a stand-in while testing.
# CLOUDFLARE_API="http://127.0.0.1:4630"
