generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
//
// Every table below carries `panelId String @default("")`. The default is not
// a real value — no Panel has an empty id, so the foreign key rejects any row
// that reaches the database still carrying it. What it buys is that panelId is
// optional in the generated create types, so the ~30 create callsites stay as
// they are and the Prisma extension in src/lib/db.ts is the only place that
// fills it in. If the extension is ever bypassed the insert fails loudly
// instead of landing in the wrong panel.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Settings — every configurable value lives here so the admin UI owns config.
// ---------------------------------------------------------------------------

model Setting {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelSettings", fields: [panelId], references: [id], onDelete: Cascade)
  key       String
  value     String // JSON-encoded
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@unique([panelId, key])
  @@index([panelId])
}

/// Sequence source for the short human-facing ids (order #, user #...).
/// SQLite only autoincrements primary keys, so the counters live here.
model Counter {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelCounters", fields: [panelId], references: [id], onDelete: Cascade)
  name    String
  value   Int    @default(0)

  @@unique([panelId, name])
}

model Language {
  id         String        @id @default(cuid())
  code       String        @unique // vi, en, tr...
  name       String
  nativeName String
  flag       String        @default("") // inline svg id
  enabled    Boolean       @default(true)
  isDefault  Boolean       @default(false)
  direction  String        @default("ltr")
  position   Int           @default(0)
  strings    Translation[]
  createdAt  DateTime      @default(now())
}

model Translation {
  id         String   @id @default(cuid())
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  namespace  String   @default("common")
  key        String
  value      String

  @@unique([languageId, namespace, key])
  @@index([languageId, namespace])
}

model Currency {
  /// Cleared to pin a hand-set rate against the automatic updater.
  autoUpdate    Boolean   @default(true)
  rateUpdatedAt DateTime?

  id           String   @id @default(cuid())
  code         String   @unique // VND, USD, EUR
  name         String
  symbol       String
  symbolBefore Boolean  @default(true)
  decimals     Int      @default(2)
  /// How the digits are punctuated: comma-dot, dot-comma, space-comma, indian
  /// or plain. It belongs to the currency and not to the reader — 2.500₫ is
  /// 2.500₫ to everybody, the same way $1,234.56 is $1,234.56 to everybody —
  /// which is why this is a column and not a locale lookup.
  numberFormat String   @default("comma-dot")
  rate         Float    @default(1) // value of 1 base currency in this currency
  enabled      Boolean  @default(true)
  isBase       Boolean  @default(false)
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Theme {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @default("")
  tokens      String // JSON: css custom properties for light/dark
  layout      String  @default("classic") // classic | compact | canvas
  enabled     Boolean @default(true)
  isDefault   Boolean @default(false)
  position    Int     @default(0)
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  panelId       String    @default("")
  panel         Panel     @relation("PanelUsers", fields: [panelId], references: [id], onDelete: Cascade)
  publicId      Int
  username      String
  email         String
  password      String
  fullName      String    @default("")
  role          String    @default("user") // user | support | admin
  balance       Float     @default(0)
  spent         Float     @default(0)
  /// Blank means "has not chosen", which is not the same as a preference that
  /// happens to match the panel's. Every one of these falls through to the
  /// panel's setting while it is blank, so an operator changing the default
  /// language or currency changes it for the accounts that never picked one —
  /// and leaves alone the accounts that did. Baking "VND" and "vi" in here
  /// made every new account Vietnamese no matter what the panel was set to.
  currency      String    @default("")
  locale        String    @default("")
  theme         String    @default("")
  colorMode     String    @default("") // dark | light | system
  timezone      String    @default("")
  /// "ltr" | "rtl", or blank to read the language's own direction — which is
  /// right for almost everyone and is why blank is the default. It is here at
  /// all because a bilingual reader may want the interface laid out the way
  /// they read rather than the way the language they picked is written.
  direction     String    @default("")
  apiKey        String    @unique @default(cuid())
  /// Where to POST when one of this account's orders finishes. Set by the
  /// reseller on their own API page; empty means they poll instead, which is
  /// what every account does until it asks not to.
  callbackUrl   String    @default("")
  emailVerified Boolean   @default(false)
  /// Base32 TOTP secret. Present but with no totpEnabledAt means setup was
  /// started and never confirmed, so it does not yet guard anything.
  totpSecret    String    @default("")
  totpEnabledAt DateTime?
  banned        Boolean   @default(false)
  banReason     String    @default("")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  authTokens      AuthToken[]
  recoveryCodes   RecoveryCode[]
  orders          Order[]
  callbacks       Callback[]
  transactions    Transaction[]
  tickets         Ticket[]           @relation("TicketAuthor")
  assignedTickets Ticket[]           @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  conversations   Conversation[]     @relation("ConversationUser")
  assignedThreads Conversation[]     @relation("ConversationAssignee")
  inboxMessages   InboxMessage[]     @relation("InboxAuthor")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  orderRequests   OrderRequest[]
  panelRequests   PanelRequest[]     @relation("UserPanelRequests")
  redemptions     CouponRedemption[]
  referralsEarned ReferralEarning[]  @relation("ReferralEarned")
  referralSource  ReferralEarning[]  @relation("ReferralSource")
  referrals       User[]             @relation("Referral")
  referrer        User?              @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referredById    String?
  /// Generated on first visit to the affiliate page, so adding this column
  /// needed no backfill and no reset of existing accounts.
  referralCode    String?

  /// Set by an admin, and then sticky: an override outranks the spend ladder.
  tierId String?
  tier   UserTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([panelId, publicId])
  @@unique([panelId, username])
  @@unique([panelId, email])
  @@unique([panelId, referralCode])
  @@index([panelId])
}

/// One-time links sent by email: password resets and address verification.
/// Separate from Session because these are consumed rather than kept alive,
/// and a used or expired row is evidence, not a login.
model AuthToken {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelAuthTokens", fields: [panelId], references: [id], onDelete: Cascade)

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// reset | verify | totp
  type      String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([panelId])
}

/// A way back in when the authenticator is gone. Stored hashed, because a
/// readable list of them is a second password list.
model RecoveryCode {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelRecoveryCodes", fields: [panelId], references: [id], onDelete: Cascade)

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([panelId])
}

model Session {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelSessions", fields: [panelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String   @default("")
  userAgent String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([panelId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelActivityLogs", fields: [panelId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([panelId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Uploaded binaries live in the database and are served by /api/media/[id],
/// so the panel works on hosts with a read-only filesystem.
model Media {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelMedia", fields: [panelId], references: [id], onDelete: Cascade)
  mime      String
  size      Int
  width     Int      @default(0)
  height    Int      @default(0)
  /// Where the file sits under public/, e.g. uploads/<panel>/<name>.png. The
  /// row is the record and the panel's claim on it; the bytes are a file.
  path      String   @default("")
  /// Older uploads, kept in the database before files were written to disk.
  /// Still served by /api/media/<id>; nothing new is written here.
  data      Bytes?
  createdAt DateTime @default(now())

  @@index([panelId])
}

model Platform {
  id             String     @id @default(cuid())
  panelId        String     @default("")
  panel          Panel      @relation("PanelPlatforms", fields: [panelId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  icon           String     @default("globe") // svg icon key, used when image is empty
  image          String     @default("") // /api/media/<id> or an external URL
  color          String     @default("#6366f1")
  /// What a link to this platform looks like, so an order can be refused at
  /// the form rather than by the provider an hour later. All three are edited
  /// in admin; a blank one simply switches that check off.
  /// Hostnames that belong here, comma separated: "instagram.com, instagr.am".
  hosts          String     @default("")
  /// Regular expressions matched against the URL path.
  postPattern    String     @default("")
  profilePattern String     @default("")
  /// Shown to the customer as the shape to copy.
  postExample    String     @default("")
  profileExample String     @default("")
  visible        Boolean    @default(true)
  position       Int        @default(0)
  categories     Category[]

  @@unique([panelId, slug])
  @@index([panelId])
}

model Category {
  id          String    @id @default(cuid())
  panelId     String    @default("")
  panel       Panel     @relation("PanelCategories", fields: [panelId], references: [id], onDelete: Cascade)
  platformId  String?
  platform    Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  /// The category's own address, under its platform. The panel routes by it:
  /// /dashboard/order/tiktok/follow. Unique per platform rather than per
  /// panel, so two platforms can both have a "follow".
  slug        String    @default("")
  name        String
  description String    @default("")
  visible     Boolean   @default(true)
  position    Int       @default(0)
  services    Service[]

  @@unique([panelId, platformId, slug])
  @@index([platformId])
  @@index([panelId])
}

model Provider {
  id             String         @id @default(cuid())
  panelId        String         @default("")
  panel          Panel          @relation("PanelProviders", fields: [panelId], references: [id], onDelete: Cascade)
  name           String
  apiUrl         String
  apiKey         String
  enabled        Boolean        @default(true)
  balance        Float          @default(0)
  currency       String         @default("USD")
  lastSyncAt     DateTime?
  /// Included in the scheduled catalogue sync rather than only imported by hand.
  autoSync       Boolean        @default(false)
  syncEveryHours Int            @default(12)
  /// What the sell price is derived from when a service follows the provider.
  markupPercent  Float          @default(60)
  /// A provider price moving more than this in one sync is reported rather
  /// than applied quietly. Zero reports nothing.
  alertPercent   Float          @default(25)
  /// Below this the provider is nearly out of funds and orders will start
  /// bouncing. Zero switches the warning off.
  lowBalance     Float          @default(0)
  services       Service[]
  backupFor      Service[]      @relation("BackupServices")
  routes         ServiceRoute[]
  orders         Order[]
  createdAt      DateTime       @default(now())

  @@index([panelId])
}

model Service {
  id                      String         @id @default(cuid())
  panelId                 String         @default("")
  panel                   Panel          @relation("PanelServices", fields: [panelId], references: [id], onDelete: Cascade)
  publicId                Int
  categoryId              String
  category                Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerId              String?
  provider                Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerServiceId       String         @default("")
  /// Where an order goes when the provider above refuses it. A service with
  /// no backup simply stays queued for an operator to look at.
  backupProviderId        String?
  backupProvider          Provider?      @relation("BackupServices", fields: [backupProviderId], references: [id], onDelete: SetNull)
  backupProviderServiceId String         @default("")
  /// The parent panel's Service this one is bought from. A child panel has no
  /// providers of its own — its only supplier is the panel above it.
  sourceServiceId         String         @default("")
  name                    String
  description             String         @default("")
  type                    String         @default("default") // default | custom_comments | subscription
  /// What the link has to point at: a single post, or the account itself.
  /// Likes belong on a post, followers belong on a profile, and sending one
  /// where the other was meant is the most common way an order fails.
  target                  String         @default("post") // post | profile
  rate                    Float // price per 1000, in base currency
  providerRate            Float          @default(0)
  /// Cleared to pin a hand-set price against the provider sync, the same way
  /// a currency pins its rate. Set means the sell price is the provider's
  /// cost plus the provider's markup, recalculated on every sync.
  autoPrice               Boolean        @default(false)
  /// Set when the provider stopped listing this service. The row is kept —
  /// orders reference it — but it is taken off sale until it comes back.
  missingSince            DateTime?
  min                     Int            @default(10)
  max                     Int            @default(100000)
  refill                  Boolean        @default(false)
  cancel                  Boolean        @default(false)
  dripfeed                Boolean        @default(false)
  /// Free text from the provider, shown as written. It cannot be compared,
  /// sorted or added up, which is why the three numbers below exist.
  averageTime             String         @default("")
  /// Short labels the customer scans before reading anything: "Hot", "Giá rẻ",
  /// "Ít tụt". Comma separated, and a label may name its colour after a colon
  /// — "Hot:danger" — from the badge set the rest of the panel uses. The words
  /// are the operator's; this file does not know a vocabulary.
  tags                    String         @default("")
  /// The three figures this market quotes, as numbers the operator states.
  /// Zero means "not stated" and shows nothing — a service that has never
  /// been sold saying "0 minutes" is a lie in the other direction.
  warrantyDays            Int            @default(0)
  startMinutes            Int            @default(0)
  speedPerDay             Int            @default(0)
  enabled                 Boolean        @default(true)
  position                Int            @default(0)
  orders                  Order[]
  routes                  ServiceRoute[]
  tierPrices              TierPrice[]
  createdAt               DateTime       @default(now())

  @@unique([panelId, publicId])
  @@index([categoryId])
  @@index([panelId])
  @@index([sourceServiceId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String         @id @default(cuid())
  panelId         String         @default("")
  panel           Panel          @relation("PanelOrders", fields: [panelId], references: [id], onDelete: Cascade)
  publicId        Int
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id])
  link            String
  quantity        Int
  charge          Float // in base currency
  /// What this order cost the panel, recorded when it was placed: the
  /// provider's rate at that moment, or what the panel above charged. Null on
  /// orders from before it was recorded, and on services fulfilled by hand —
  /// the profit report counts neither rather than claiming a margin it does
  /// not know. It is stored rather than derived because provider rates move.
  cost            Float?
  startCount      Int            @default(0)
  remains         Int            @default(0)
  status          String         @default("pending") // held pending processing inprogress completed partial canceled refunded
  /// Why an abuse rule held this order back, in the operator's own terms.
  /// Empty on every order that was never held — which, with the rules off by
  /// default, is all of them.
  holdReason      String         @default("")
  providerOrderId String         @default("")
  /// Which provider actually took this order. Set when it is sent, so status
  /// and refill follow the provider it went to rather than whichever one the
  /// service points at today.
  providerId      String?
  provider        Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  /// One comment per line, for services that take them instead of a count.
  /// The quantity is then the number of lines.
  comments        String         @default("")
  /// The order one level down that caused this one. Following it walks the
  /// chain back to the customer who actually placed it.
  sourceOrderId   String         @default("")
  note            String         @default("")
  runs            Int?
  interval        Int?
  /// Subscription services watch a profile and deliver on each new post. For
  /// those orders `link` holds the username being watched rather than a URL,
  /// and `quantity` is the ceiling that was charged: posts x maxPerPost.
  posts           Int?
  minPerPost      Int?
  maxPerPost      Int?
  /// Minutes to wait after a post appears before delivering.
  delay           Int?
  expiry          DateTime?
  /// When this order may be sent on. Null is "now", which is every order
  /// nobody scheduled. It is charged at once either way: a balance committed
  /// when the customer was looking is worth more than one checked at 3am.
  startAt         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// When the order stopped moving — completed, partial, cancelled, refunded.
  /// updatedAt is not this: it changes whenever anything touches the row, so
  /// "how long delivery took" measured from it would quietly drift.
  settledAt       DateTime?
  requests        OrderRequest[]
  events          OrderEvent[]

  @@unique([panelId, publicId])
  @@index([userId])
  @@index([status])
  @@index([panelId])
  @@index([sourceOrderId])
  @@index([status, startAt])
}

/// Customer-raised refill and cancel requests. Both follow the same
/// lifecycle, so they share a table with a discriminator rather than two
/// near-identical ones.
model OrderRequest {
  id                String   @id @default(cuid())
  panelId           String   @default("")
  panel             Panel    @relation("PanelOrderRequests", fields: [panelId], references: [id], onDelete: Cascade)
  publicId          Int
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // refill | cancel
  status            String   @default("pending") // pending | approved | rejected | completed
  note              String   @default("")
  providerRequestId String   @default("")
  /// The request one level down that raised this one, mirroring the way
  /// sourceOrderId links the orders themselves.
  sourceRequestId   String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([panelId, publicId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([sourceRequestId])
  @@index([panelId])
}

// ---------------------------------------------------------------------------
// Wallet & payments
// ---------------------------------------------------------------------------

model PaymentMethod {
  id           String        @id @default(cuid())
  panelId      String        @default("")
  panel        Panel         @relation("PanelPaymentMethods", fields: [panelId], references: [id], onDelete: Cascade)
  code         String // seapay | paypal | link | manual_bank | crypto
  name         String
  driver       String // implementation key
  enabled      Boolean       @default(false)
  icon         String        @default("wallet")
  description  String        @default("")
  config       String        @default("{}") // JSON credentials, edited in admin
  currencies   String        @default("[]") // JSON array of accepted currency codes
  minAmount    Float         @default(0)
  maxAmount    Float         @default(0)
  feePercent   Float         @default(0)
  feeFixed     Float         @default(0)
  bonusPercent Float         @default(0)
  position     Int           @default(0)
  transactions Transaction[]

  @@unique([panelId, code])
  @@index([panelId])
}

model Transaction {
  id           String         @id @default(cuid())
  panelId      String         @default("")
  panel        Panel          @relation("PanelTransactions", fields: [panelId], references: [id], onDelete: Cascade)
  publicId     Int
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  methodId     String?
  method       PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  type         String         @default("deposit") // deposit | order | refund | admin_credit | admin_debit | bonus
  amount       Float // base currency, signed
  paidAmount   Float          @default(0) // amount in payment currency
  currency     String         @default("VND")
  fee          Float          @default(0)
  status       String         @default("pending") // pending | completed | failed | canceled
  reference    String         @default("") // gateway transaction id
  note         String         @default("")
  meta         String         @default("{}")
  balanceAfter Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([panelId, publicId])
  @@index([userId])
  @@index([status])
  @@index([panelId])
}

// ---------------------------------------------------------------------------
// Support & notifications
// ---------------------------------------------------------------------------

model Ticket {
  id           String          @id @default(cuid())
  panelId      String          @default("")
  panel        Panel           @relation("PanelTickets", fields: [panelId], references: [id], onDelete: Cascade)
  publicId     Int
  userId       String
  user         User            @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  /// The staff member holding this ticket. Null means nobody has claimed it.
  /// Cleared rather than cascaded when that account goes: the ticket outlives
  /// whoever was working it.
  assigneeId   String?
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject      String
  category     String          @default("general")
  status       String          @default("open") // open | answered | pending | closed
  /// 0 low, 1 normal, 2 high, 3 urgent — a number so the queue sorts in SQL.
  /// Set by support, never by the customer. See src/lib/tickets.ts.
  priority     Int             @default(1)
  /// Set when this ticket was folded into another. The row stays, because the
  /// customer quoted its number and has to keep finding the conversation by it.
  mergedIntoId String?
  mergedInto   Ticket?         @relation("TicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Ticket[]        @relation("TicketMerge")
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([panelId, publicId])
  @@index([userId])
  @@index([panelId])
  @@index([panelId, priority, updatedAt])
  @@index([assigneeId])
  @@index([mergedIntoId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelTicketMessages", fields: [panelId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([panelId])
}

/// One step in an order's life.
///
/// Written wherever a status is decided, never derived. "It never started" is
/// otherwise one person's word against another's, and a refill decision rests
/// on when delivery began and from what count — neither of which the order row
/// remembers once it has moved on.
model OrderEvent {
  id         String   @id @default(cuid())
  panelId    String   @default("")
  panel      Panel    @relation("PanelOrderEvents", fields: [panelId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Empty on the first event, which is the order being created.
  from       String   @default("")
  to         String
  /// The counts as they stood at this step, so a drop can be read off the
  /// timeline rather than inferred from the current row.
  startCount Int      @default(0)
  remains    Int      @default(0)
  /// "customer", "provider", "chain", "system", or a staff username. What
  /// moved it, in the words the reader needs rather than a class name.
  actor      String   @default("system")
  /// Free text the deciding code wanted on the record — which provider
  /// refused, why it was cancelled.
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([panelId])
}

/// One outbound notification to a reseller's own server.
///
/// A row rather than a fetch at the moment the order settles: the reseller's
/// server will be down sometimes, and losing the one message that says their
/// customer's order is finished is worse than any amount of retrying. Written
/// inside the same transaction as the status change, so a delivered status and
/// a queued callback cannot disagree.
model Callback {
  id            String    @id @default(cuid())
  panelId       String    @default("")
  panel         Panel     @relation("PanelCallbacks", fields: [panelId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String
  /// The order's public id, copied in: it is what the reseller knows the order
  /// by, and it has to survive the order being deleted.
  publicId      Int
  /// pending | delivered | failed
  status        String    @default("pending")
  /// The exact bytes that were signed. Kept rather than rebuilt at send time so
  /// a retry sends what the first attempt promised, even if the order has
  /// moved on since.
  payload       String
  attempts      Int       @default(0)
  /// Backs off exponentially. The delivery pass only looks at rows due now.
  nextAttemptAt DateTime  @default(now())
  /// The last HTTP status, or 0 when the request never completed.
  lastCode      Int       @default(0)
  lastError     String    @default("")
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([panelId])
}

/// A search phrase the operator wants to know their position for.
model Keyword {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelKeywords", fields: [panelId], references: [id], onDelete: Cascade)
  phrase  String
  /// Two-letter country the search is run from, because a panel selling in
  /// Vietnam does not care where it ranks in the United States.
  country String @default("vn")

  /// Filled from the newest reading so the list can sort and colour without
  /// reading history for every row. Zero means "not in the range checked",
  /// which is not the same as position zero.
  position     Int       @default(0)
  /// The position before that, so the arrow beside a row means something.
  lastPosition Int       @default(0)
  /// Which of our pages was found there. Useful when the wrong page ranks.
  url          String    @default("")
  checkedAt    DateTime?
  /// Why the last check produced nothing, in the operator's words.
  lastError    String    @default("")
  createdAt    DateTime  @default(now())

  ranks KeywordRank[]

  @@unique([panelId, phrase, country])
  @@index([panelId])
}

/// One reading, kept so a position can be shown as a trend rather than a
/// number that silently changes.
model KeywordRank {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelKeywordRanks", fields: [panelId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position  Int
  url       String   @default("")
  /// Which source said so — readings from different sources mean different
  /// things and should never be drawn on one line as though they agree.
  source    String
  createdAt DateTime @default(now())

  @@index([keywordId, createdAt])
  @@index([panelId])
}

/// Links and accounts the operator has decided this panel will not serve.
///
/// Deliberately not a rule that holds an order for review: someone typed this
/// value in on purpose, so queueing it back to them to approve would be a
/// loop. A blocked order is refused at the door and never charged.
model Blocklist {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelBlocklist", fields: [panelId], references: [id], onDelete: Cascade)
  /// "link" matches anywhere in the order's link; "username" is the whole
  /// account name. Two kinds rather than a pattern language, because an
  /// operator adding a scam domain at 2am should not have to write a regex.
  kind      String
  value     String
  /// Why, for whoever reads the list in six months.
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([panelId, kind, value])
  @@index([panelId])
}

model Notification {
  id        String    @id @default(cuid())
  panelId   String    @default("")
  panel     Panel     @relation("PanelNotifications", fields: [panelId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What happened, and the values its sentence needs. The reader's language
  // decides the words, so they are not stored — see src/lib/notify.ts.
  key       String    @default("")
  params    String    @default("{}")
  // The English rendering, kept as written. It is what rows created before
  // keys existed still show, and what an operator reads in the database.
  title     String
  body      String
  level     String    @default("info") // info | success | warning | danger
  read      Boolean   @default(false)
  href      String    @default("")
  /// When this was also sent as email. Kept on the row rather than sent at
  /// write time: notifications are written inside money transactions, and a
  /// mail server being slow must not hold one open or roll one back.
  mailedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([panelId])
}

/// Deposit coupons. Redemptions are recorded separately so per-user limits
/// and reporting do not depend on a counter that can drift.
model Coupon {
  id               String             @id @default(cuid())
  panelId          String             @default("")
  panel            Panel              @relation("PanelCoupons", fields: [panelId], references: [id], onDelete: Cascade)
  code             String
  type             String             @default("percent") // percent | fixed
  value            Float              @default(0)
  minAmount        Float              @default(0) // in base currency
  maxUses          Int                @default(0) // 0 = unlimited
  maxPerUser       Int                @default(1) // 0 = unlimited
  firstDepositOnly Boolean            @default(false)
  expiresAt        DateTime?
  enabled          Boolean            @default(true)
  createdAt        DateTime           @default(now())
  redemptions      CouponRedemption[]

  @@unique([panelId, code])
  @@index([panelId])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  panelId       String   @default("")
  panel         Panel    @relation("PanelCouponRedemptions", fields: [panelId], references: [id], onDelete: Cascade)
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  bonus         Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([panelId])
}

/// Commission owed to a referrer for one of their referral's deposits.
model ReferralEarning {
  id            String   @id @default(cuid())
  panelId       String   @default("")
  panel         Panel    @relation("PanelReferralEarnings", fields: [panelId], references: [id], onDelete: Cascade)
  referrerId    String
  referrer      User     @relation("ReferralEarned", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String
  referred      User     @relation("ReferralSource", fields: [referredId], references: [id], onDelete: Cascade)
  transactionId String   @unique
  amount        Float
  ratePercent   Float
  status        String   @default("earned") // earned | withdrawn
  createdAt     DateTime @default(now())

  @@index([referrerId])
  @@index([panelId])
}

model Announcement {
  id        String   @id @default(cuid())
  panelId   String   @default("")
  panel     Panel    @relation("PanelAnnouncements", fields: [panelId], references: [id], onDelete: Cascade)
  title     String
  body      String
  level     String   @default("info")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([panelId])
}

model Page {
  id           String   @id @default(cuid())
  panelId      String   @default("")
  panel        Panel    @relation("PanelPages", fields: [panelId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  body         String
  published    Boolean  @default(true)
  showInFooter Boolean  @default(true)
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([panelId, slug])
  @@index([panelId])
}

/// Customer tiers. Each tier can take a flat percentage off every price, and
/// override individual services outright when the percentage is the wrong
/// shape for a particular one.
model UserTier {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelTiers", fields: [panelId], references: [id], onDelete: Cascade)

  name            String
  slug            String
  /// Percentage off the list price. Ignored for services with a manual price.
  discountPercent Float   @default(0)
  /// Lifetime spend that reaches this tier on its own. 0 = assigned by hand.
  minSpent        Float   @default(0)
  color           String  @default("#6366f1")
  /// The tier a customer sits in before they have spent anything.
  isDefault       Boolean @default(false)
  position        Int     @default(0)

  users     User[]
  prices    TierPrice[]
  createdAt DateTime    @default(now())

  @@unique([panelId, slug])
  @@index([panelId])
}

/// One service priced by hand for one tier, overriding the tier percentage.
model TierPrice {
  id      String @id @default(cuid())
  panelId String @default("")
  panel   Panel  @relation("PanelTierPrices", fields: [panelId], references: [id], onDelete: Cascade)

  tierId    String
  tier      UserTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rate      Float

  @@unique([tierId, serviceId])
  @@index([panelId])
  @@index([serviceId])
}

// ---------------------------------------------------------------------------
// Panels — the root panel plus every child panel resold beneath it.
// ---------------------------------------------------------------------------

/// One storefront. The root panel is the one with no parent; every other row
/// was created by the panel above it and buys its services from that panel.
///
/// `path` is the materialised ancestor chain (root id first, own id last,
/// slash-separated). It makes "is A an ancestor of B" a string test instead of
/// a recursive query, which SQLite cannot express cheaply, and it is what the
/// order-routing code will use to refuse cycles.
/// A customer quote on the landing page. Written by the panel's admin from
/// what a real customer said — there is no submission path from users, so
/// nothing here arrives unreviewed.
model Testimonial {
  id       String  @id @default(cuid())
  panelId  String  @default("")
  panel    Panel   @relation("PanelTestimonials", fields: [panelId], references: [id], onDelete: Cascade)
  name     String
  role     String  @default("")
  body     String
  /// Whole stars, 1-5. Zero hides the rating rather than showing none.
  rating   Int     @default(5)
  avatar   String  @default("")
  visible  Boolean @default(true)
  position Int     @default(0)

  @@index([panelId])
}

/// One question on the landing page's FAQ.
model Faq {
  id       String  @id @default(cuid())
  panelId  String  @default("")
  panel    Panel   @relation("PanelFaqs", fields: [panelId], references: [id], onDelete: Cascade)
  question String
  answer   String
  visible  Boolean @default(true)
  position Int     @default(0)

  @@index([panelId])
}

/// A connected messaging account: a Telegram bot, a Facebook page, a Zalo OA.
/// One panel can hold several of each.
model Channel {
  id         String  @id @default(cuid())
  panelId    String  @default("")
  panel      Panel   @relation("PanelChannels", fields: [panelId], references: [id], onDelete: Cascade)
  kind       String // telegram | messenger | zalo | instagram
  /// The operator's own label for it, shown in the inbox.
  name       String
  /// The account's id on the platform. Incoming events name it, which is how
  /// one webhook address serves every channel a panel has connected.
  externalId String  @default("")
  enabled    Boolean @default(true)
  /// JSON credentials, written in admin and never shown back in full.
  config     String  @default("{}")
  position   Int     @default(0)

  conversations Conversation[]
  createdAt     DateTime       @default(now())

  @@unique([panelId, kind, externalId])
  @@index([panelId])
}

/// One person talking to one channel.
model Conversation {
  id            String  @id @default(cuid())
  panelId       String  @default("")
  panel         Panel   @relation("PanelConversations", fields: [panelId], references: [id], onDelete: Cascade)
  channelId     String
  channel       Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// The thread's id on the platform — chat id, PSID, user id.
  externalId    String
  contactName   String  @default("")
  contactHandle String  @default("")
  /// Set when the person is recognised as a panel customer.
  userId        String?
  user          User?   @relation("ConversationUser", fields: [userId], references: [id], onDelete: SetNull)
  status        String  @default("open") // open | closed
  assigneeId    String?
  assignee      User?   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Incoming messages nobody on the team has read yet.
  unread        Int     @default(0)

  messages  InboxMessage[]
  createdAt DateTime       @default(now())
  /// When the thread last moved, in either direction. The inbox sorts on it.
  lastAt    DateTime       @default(now())

  @@unique([panelId, channelId, externalId])
  @@index([panelId, status, lastAt])
  @@index([channelId])
}

model InboxMessage {
  id             String       @id @default(cuid())
  panelId        String       @default("")
  panel          Panel        @relation("PanelInboxMessages", fields: [panelId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "in" from the customer, "out" from the team.
  direction      String
  body           String
  /// The platform's own id. Null on our own sends, and NULLs do not collide in
  /// a SQLite unique index — which is what makes the constraint below work as
  /// idempotency for redelivered webhooks without blocking repeat replies.
  externalId     String?
  authorId       String?
  author         User?        @relation("InboxAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([panelId, conversationId, externalId])
  @@index([conversationId])
}

/// One turn of the scheduler.
///
/// Deliberately not panel-scoped: the cycle runs for every panel in one pass,
/// and a cron request has no host to resolve a panel from. It is the record of
/// the engine itself, not of anybody's shop.
model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  /// Null while a run is in flight, and left null if the process dies — which
  /// is itself the signal that something went wrong mid-cycle.
  finishedAt DateTime?
  dispatched Int       @default(0)
  synced     Int       @default(0)
  mailed     Int       @default(0)
  /// Everything the cycle complained about, one per line. Empty is the good case.
  failures   String    @default("")
  /// "cron" or the username who pressed the button, so a run nobody expected
  /// can be traced to whoever caused it.
  trigger    String    @default("cron")

  @@index([startedAt])
}

model Panel {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?
  parent   Panel?  @relation("PanelTree", fields: [parentId], references: [id])
  children Panel[] @relation("PanelTree")
  depth    Int     @default(0)
  path     String  @default("")

  /// The owner's account on the PARENT panel — the balance that pays rent and
  /// wholesale. Deliberately not a relation: the owner of the root panel has
  /// no parent-side account, and a child's owner lives in a different tenant.
  ownerUserId String @default("")

  /// active — trading. suspended — switched off by hand. expired — rent went
  /// unpaid past its grace period. Only `expired` comes back on its own.
  status     String @default("active")
  statusNote String @default("")

  /// What this panel is charged per period. Null follows the parent's
  /// `panel.rentPrice` setting, so raising the standard price moves every
  /// child that never negotiated its own.
  /// Addresses this panel's payment webhooks. A gateway is configured with one
  /// fixed callback URL, which may not be on this panel's own hostname, so the
  /// URL carries the panel rather than relying on the Host header.
  webhookToken String @default("")

  rentPrice    Float?
  nextDueAt    DateTime?
  lastBilledAt DateTime?

  domains        PanelDomain[]
  settings       Setting[]          @relation("PanelSettings")
  counters       Counter[]          @relation("PanelCounters")
  users          User[]             @relation("PanelUsers")
  sessions       Session[]          @relation("PanelSessions")
  authTokens     AuthToken[]        @relation("PanelAuthTokens")
  recoveryCodes  RecoveryCode[]     @relation("PanelRecoveryCodes")
  activityLogs   ActivityLog[]      @relation("PanelActivityLogs")
  media          Media[]            @relation("PanelMedia")
  platforms      Platform[]         @relation("PanelPlatforms")
  categories     Category[]         @relation("PanelCategories")
  providers      Provider[]         @relation("PanelProviders")
  serviceRoutes  ServiceRoute[]     @relation("PanelServiceRoutes")
  services       Service[]          @relation("PanelServices")
  orders         Order[]            @relation("PanelOrders")
  orderRequests  OrderRequest[]     @relation("PanelOrderRequests")
  paymentMethods PaymentMethod[]    @relation("PanelPaymentMethods")
  transactions   Transaction[]      @relation("PanelTransactions")
  tickets        Ticket[]           @relation("PanelTickets")
  ticketMessages TicketMessage[]    @relation("PanelTicketMessages")
  notifications  Notification[]     @relation("PanelNotifications")
  coupons        Coupon[]           @relation("PanelCoupons")
  redemptions    CouponRedemption[] @relation("PanelCouponRedemptions")
  earnings       ReferralEarning[]  @relation("PanelReferralEarnings")
  announcements  Announcement[]     @relation("PanelAnnouncements")
  pages          Page[]             @relation("PanelPages")
  testimonials   Testimonial[]      @relation("PanelTestimonials")
  faqs           Faq[]              @relation("PanelFaqs")
  channels       Channel[]          @relation("PanelChannels")
  conversations  Conversation[]     @relation("PanelConversations")
  inboxMessages  InboxMessage[]     @relation("PanelInboxMessages")
  orderEvents    OrderEvent[]       @relation("PanelOrderEvents")
  blocklist      Blocklist[]        @relation("PanelBlocklist")
  callbacks      Callback[]         @relation("PanelCallbacks")
  keywords       Keyword[]          @relation("PanelKeywords")
  keywordRanks   KeywordRank[]      @relation("PanelKeywordRanks")
  tiers          UserTier[]         @relation("PanelTiers")
  tierPrices     TierPrice[]        @relation("PanelTierPrices")
  panelRequests  PanelRequest[]     @relation("PanelPanelRequests")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([parentId])
  @@index([path])
}

/// Hostnames that serve a panel. One panel can have several (the working
/// hostname it was created with, plus custom domains added later), so this is
/// a table rather than a column.
/// A customer asking for a panel of their own.
///
/// The reseller owns a domain and wants it to be their storefront. Rather
/// than mail the operator and wait, they ask here: the panel adds their
/// domain to its own Cloudflare account, hands back the two nameservers to
/// set at their registrar, and watches for the delegation to take effect.
/// Changing the nameservers is itself the proof of ownership — nobody can
/// point a domain they do not control — so no TXT record is needed on top.
///
/// The operator still approves. What is automatic is the DNS and the panel
/// that gets built on approval, not the decision to take somebody on.
model PanelRequest {
  id       String @id @default(cuid())
  /// The panel being asked, which is the parent the new one would sit under.
  panelId  String @default("")
  panel    Panel  @relation("PanelPanelRequests", fields: [panelId], references: [id], onDelete: Cascade)
  publicId Int
  /// The customer asking, who holds the balance rent comes out of.
  userId   String
  user     User   @relation("UserPanelRequests", fields: [userId], references: [id], onDelete: Cascade)

  name String
  slug String
  host String

  /// The zone created for their domain in the operator's Cloudflare account,
  /// and the nameservers it was assigned. Both blank until Cloudflare is
  /// configured and the zone has been created.
  zoneId      String @default("")
  nameServers String @default("")

  /// pending — waiting for the customer to move their nameservers
  /// delegated — Cloudflare answers for the domain; ready to approve
  /// approved — the panel exists
  /// rejected — the operator said no, with a reason
  status         String @default("pending")
  /// Why it was rejected, or what went wrong creating the zone.
  note           String @default("")
  /// The panel this became, once approved.
  createdPanelId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([panelId, publicId])
  @@unique([panelId, host])
  @@index([panelId, status])
  @@index([userId])
}

model PanelDomain {
  id          String   @id @default(cuid())
  panelId     String
  panel       Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  host        String   @unique // lowercase, no port
  verified    Boolean  @default(false)
  isPrimary   Boolean  @default(false)
  /// Random token the owner publishes as a TXT record to prove ownership.
  /// Unused for hostnames inside a zone the panel itself controls.
  verifyToken String   @default("")
  /// Set when the panel created this hostname's DNS record through
  /// Cloudflare, so deleting the hostname can take the record with it.
  dnsRecordId String   @default("")
  createdAt   DateTime @default(now())

  @@index([panelId])
}

/// Every provider that can fulfil one service.
///
/// A service used to name exactly two: a first choice and a backup, tried in
/// that order whatever they cost. Suppliers do not hold a price still, so the
/// fixed order was a standing instruction to overpay. These are tried cheapest
/// first instead, skipping any provider that is off or out of funds.
///
/// The service's own provider and backup are written here as routes too, so
/// dispatch has one list to read rather than three places to look.
model ServiceRoute {
  id                String   @id @default(cuid())
  panelId           String   @default("")
  panel             Panel    @relation("PanelServiceRoutes", fields: [panelId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId        String
  provider          Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// The id this service goes by at that provider.
  providerServiceId String
  /// Cost per 1000 there, in the base currency. Refreshed by the catalogue sync.
  cost              Float    @default(0)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([serviceId, providerId])
  @@index([panelId])
  @@index([serviceId])
}
